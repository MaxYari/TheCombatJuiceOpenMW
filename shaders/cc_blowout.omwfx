uniform_float uStrength {
    default = 0.0;
    min = 0.0;
    step = 0.01;
    display_name = "Flash Strength";
    static = false;
}

uniform_float uRadial {
    default = 0.1;
    min = 0.0;
    max = 0.5;
    step = 0.005;
    display_name = "Radial Blur";
    description = "How far the image is smeared out from the middle of the screen. Sanguine Symphony's death imagespace uses 0.15 for this.";
}

uniform_float uContrast {
    default = 1.35;
    min = 1.0;
    step = 0.01;
    display_name = "Contrast";
    description = "Sanguine Symphony's death imagespace uses 1.3.";
}

uniform_float uPivot {
    default = 0.22;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Contrast Pivot";
    description = "The brightness the contrast turns about. Anything below it darkens, so it sits low: in a Morrowind interior mid grey would put most of the screen on the wrong side of it.";
}

uniform_float uExposure {
    default = 0.35;
    min = 0.0;
    step = 0.01;
    display_name = "Exposure Lift";
    description = "A straight multiply over the whole image.";
}

uniform_float uBloom {
    default = 0.9;
    min = 0.0;
    step = 0.05;
    display_name = "Bloom";
    description = "How much of the blown out highlights is smeared back over the image.";
}

uniform_float uThreshold {
    default = 0.55;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Bloom Threshold";
    description = "Brightness a pixel needs before it blooms, measured after the exposure lift.";
}

uniform_float uBloomRadius {
    default = 0.06;
    min = 0.0;
    max = 0.3;
    step = 0.005;
    display_name = "Bloom Radius";
    description = "How far the bloom spreads, as a fraction of screen height.";
}

uniform_float uDesaturate {
    default = 0.3;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Desaturation";
    description = "Sanguine Symphony's death imagespace goes all the way to 1, fully monochrome. 0.3 keeps the scene's own colour while taking the edge off it.";
}

uniform_vec3 uTint {
    default = vec3(1.0, 0.22, 0.18);
    min = vec3(0.0, 0.0, 0.0);
    max = vec3(1.0, 1.0, 1.0);
    display_name = "Tint";
    description = "Colour mixed in at the peak. Red, as the Skyrim mod's 'subtle red' death flash does it.";
}

uniform_float uTintAmount {
    default = 0.06;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Tint Amount";
    description = "Sanguine Symphony uses 0.059.";
}

shared {
    const vec3 CC_LUMA = vec3(0.2126, 0.7152, 0.0722);

    // Contrast about a low pivot, then a straight lift. Everything the flash
    // does to tone happens here, so the bright pass and the composite agree on
    // what counts as blown out.
    vec3 ccTone(vec3 color, float s)
    {
        float contrast = mix(1.0, uContrast, s);
        color = (color - vec3(uPivot)) * contrast + vec3(uPivot);
        color *= 1.0 + uExposure * s;
        return max(color, vec3(0.0));
    }
}

render_target RT_CCGlare {
    width_ratio = 0.25;
    height_ratio = 0.25;
    min_filter = linear;
    mag_filter = linear;
    wrap_s = clamp_to_edge;
    wrap_t = clamp_to_edge;
}

fragment cc_bright(target=RT_CCGlare) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        if (uStrength <= 0.0)
        {
            omw_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
            return;
        }

        // Four full res taps per quarter res pixel, so nothing bright is missed.
        vec2 o = omw.rcpResolution;
        vec3 c = omw_GetLastShader(omw_TexCoord + vec2(-o.x, -o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(o.x, -o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(-o.x, o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(o.x, o.y)).rgb;
        c *= 0.25;

        vec3 toned = ccTone(c, uStrength);
        float luma = dot(toned, CC_LUMA);
        float over = clamp((luma - uThreshold) / max(1.0 - uThreshold, 0.001), 0.0, 2.0);

        omw_FragColor = vec4(toned * over, 1.0);
    }
}

fragment cc_flash(rt1=RT_CCGlare) {
    omw_In vec2 omw_TexCoord;

    const int ZOOM_TAPS = 6;
    const int GLARE_TAPS = 12;

    void main()
    {
        vec4 scene = omw_GetLastShader(omw_TexCoord);

        if (uStrength <= 0.0)
        {
            omw_FragColor = scene;
            return;
        }

        float s = uStrength;
        vec2 centre = vec2(0.5);

        // Zoom blur out of the middle of the screen. This is the part that reads
        // as impact rather than as a brightness change, and it is what Skyrim's
        // imagespace does with its radial blur strength.
        vec3 blurred = vec3(0.0);
        float total = 0.0;
        for (int i = 0; i < ZOOM_TAPS; ++i)
        {
            float f = float(i) / float(ZOOM_TAPS - 1);
            float weight = 1.0 - 0.55 * f;
            blurred += omw_GetLastShader(mix(omw_TexCoord, centre, f * uRadial * s)).rgb * weight;
            total += weight;
        }
        blurred /= max(total, 0.0001);

        vec3 color = ccTone(blurred, s);

        // Round bloom over the quarter res bright buffer, already soft from
        // being downsampled with linear filtering.
        vec2 aspect = vec2(omw.resolution.x / omw.resolution.y, 1.0);
        vec3 glare = vec3(0.0);
        total = 0.0;
        for (int i = 0; i < GLARE_TAPS; ++i)
        {
            float fi = float(i);
            float angle = fi * 2.39996323;
            float radius = sqrt((fi + 0.5) / float(GLARE_TAPS)) * uBloomRadius;
            float weight = 1.0 - 0.55 * radius / max(uBloomRadius, 0.0001);
            vec2 offset = vec2(cos(angle), sin(angle)) * radius / aspect;
            glare += omw_Texture2D(RT_CCGlare, omw_TexCoord + offset).rgb * weight;
            total += weight;
        }
        color += glare / max(total, 0.0001) * uBloom * s;

        // Drain some colour and put a little of the tint back, the way the
        // Skyrim mod's death flash goes monochrome with a touch of red.
        float luma = dot(color, CC_LUMA);
        color = mix(color, vec3(luma), uDesaturate * s);
        color = mix(color, uTint * max(luma, 0.0), uTintAmount * s);

        omw_FragColor = vec4(color, scene.a);
    }
}

technique {
    passes = cc_bright, cc_flash;
    description = "Cinematic Combat: a kill flash after Sanguine Symphony's death imagespace - zoom blur, contrast, bloom, a drain of colour and a touch of red.";
    version = "1.2";
    author = "Max Yari";
    dynamic = true;
}
