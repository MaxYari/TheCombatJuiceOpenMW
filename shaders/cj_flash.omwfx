uniform_float uStrength {
    default = 0.0;
    min = 0.0;
    step = 0.01;
    display_name = "Flash Strength";
    static = false;
}

uniform_float uRadial {
    default = 0.1;
    min = 0.0;
    max = 0.5;
    step = 0.005;
    display_name = "Radial Blur";
    description = "How far the image is smeared out from the middle of the screen. Sanguine Symphony's death imagespace uses 0.15 for this.";
}

uniform_float uContrastMul {
    default = 1.0;
    min = 1.0;
    step = 0.01;
    display_name = "Contrast";
    description = "A multiplier: 1.0 leaves contrast alone, 0 flattens the image to a single grey. Sanguine Symphony's death imagespace uses 1.3, but contrast turns about the pivot below, and in a dark cave most of the screen sits under any sensible pivot and would be darkened by it. Off by default; the bloom carries the flash instead.";
}

uniform_float uPivot {
    default = 0.22;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Contrast Pivot";
    description = "The brightness the contrast turns about. Anything below it darkens, so it sits low: in a Morrowind interior mid grey would put most of the screen on the wrong side of it.";
}

uniform_float uExposureMul {
    default = 0.25;
    min = 0.0;
    step = 0.01;
    display_name = "Exposure Lift";
    description = "A straight multiply over the whole image. Kept small: in the footage this is tuned against the flash is nearly all added light, not a brightening of what was already there.";
}

uniform_float uBloom {
    default = 1.7;
    min = 0.0;
    step = 0.05;
    display_name = "Bloom";
    description = "How much of the blown out highlights is smeared back over the image.";
}

uniform_float uThreshold {
    default = 0.55;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Bloom Threshold";
    description = "Brightness a pixel needs before it blooms, measured after the exposure lift.";
}

uniform_float uBloomRadius {
    default = 0.06;
    min = 0.0;
    max = 0.3;
    step = 0.005;
    display_name = "Bloom Radius";
    description = "How far the bloom spreads, as a fraction of screen height.";
}

uniform_float uLitFrom {
    default = 0.12;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Lit From";
    description = "Brightness at which a pixel starts counting as lit. The wash and the tint below only touch what is lit, fading in from here to about half again as bright, so the flash reads as the light in the room turning cold rather than as a colour laid over the screen. Shadows keep their own colour.";
}

uniform_float uWash {
    default = 0.1;
    min = 0.0;
    step = 0.01;
    display_name = "Cold Wash";
    description = "A flat amount of tinted light added over everything, so the flash still lands in a pitch dark cave where there is nothing bright enough to bloom. Keep it small: it lifts the blacks while it is on.";
}

uniform_float uSaturation {
    default = 1.35;
    min = 0.0;
    step = 0.01;
    display_name = "Saturation";
    description = "Colour at the peak, as a multiplier. Above 1 deepens it, which is what the reference footage does - its saturation almost doubles. 0 is fully monochrome, the way Sanguine Symphony's own death imagespace does it.";
}

uniform_float uGlareColorize {
    default = 0.9;
    min = 0.0;
    max = 1.0;
    step = 0.05;
    display_name = "Glare Colourise";
    description = "How far the bloom is repainted in the glare tint rather than keeping the colour of whatever is glowing. This matters: multiplying a warm glare by a cold tint cannot make blue light, there is no blue in it to scale up, so in a torchlit room a tinted bloom still comes out warm. At 1 the bloom is the tint colour and nothing else.";
}

uniform_vec3 uGlareTint {
    default = vec3(0.3, 0.78, 1.45);
    min = vec3(0.0, 0.0, 0.0);
    display_name = "Glare Tint";
    description = "Colour of the light the bloom adds. Cold by default: in the reference footage the flash adds three times as much blue and green as red.";
}

uniform_vec3 uTint {
    default = vec3(0.5, 0.9, 1.4);
    min = vec3(0.0, 0.0, 0.0);
    max = vec3(1.0, 1.0, 1.0);
    display_name = "Tint";
    description = "Colour mixed over the whole image at the peak. Cold, which is what the reference footage does - its flash turns the frame from warm to blue. Sanguine Symphony's own death flash uses red, vec3(1.0, 0.22, 0.18) at 0.059, if you would rather have that.";
}

uniform_float uTintAmount {
    default = 0.35;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Tint Amount";
    description = "How much of the tint is mixed over the frame at the peak. 0.25 is the least that flips a warm Morrowind interior cold; 0.35 makes it read as a cold flash rather than just a neutral one. Past 0.5 it starts to look like a blue filter.";
}

shared {
    const vec3 CJ_LUMA = vec3(0.2126, 0.7152, 0.0722);

    // Contrast about a low pivot, then a straight lift. Everything the flash
    // does to tone happens here, so the bright pass and the composite agree on
    // what counts as blown out.
    vec3 ccTone(vec3 color, float s)
    {
        float contrast = mix(1.0, uContrastMul, s);
        color = (color - vec3(uPivot)) * contrast + vec3(uPivot);
        color *= 1.0 + uExposureMul * s;
        return max(color, vec3(0.0));
    }
}

render_target RT_CCGlare {
    width_ratio = 0.25;
    height_ratio = 0.25;
    min_filter = linear;
    mag_filter = linear;
    wrap_s = clamp_to_edge;
    wrap_t = clamp_to_edge;
}

fragment cc_bright(target=RT_CCGlare) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        if (uStrength <= 0.0)
        {
            omw_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
            return;
        }

        // Four full res taps per quarter res pixel, so nothing bright is missed.
        vec2 o = omw.rcpResolution;
        vec3 c = omw_GetLastShader(omw_TexCoord + vec2(-o.x, -o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(o.x, -o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(-o.x, o.y)).rgb;
        c += omw_GetLastShader(omw_TexCoord + vec2(o.x, o.y)).rgb;
        c *= 0.25;

        vec3 toned = ccTone(c, uStrength);
        float luma = dot(toned, CJ_LUMA);
        float over = clamp((luma - uThreshold) / max(1.0 - uThreshold, 0.001), 0.0, 2.0);

        omw_FragColor = vec4(toned * over, 1.0);
    }
}

fragment cj_flash(rt1=RT_CCGlare) {
    omw_In vec2 omw_TexCoord;

    const int ZOOM_TAPS = 6;
    const int GLARE_TAPS = 12;

    void main()
    {
        vec4 scene = omw_GetLastShader(omw_TexCoord);

        if (uStrength <= 0.0)
        {
            omw_FragColor = scene;
            return;
        }

        float s = uStrength;
        vec2 centre = vec2(0.5);

        // Zoom blur out of the middle of the screen. This is the part that reads
        // as impact rather than as a brightness change, and it is what Skyrim's
        // imagespace does with its radial blur strength.
        vec3 blurred = vec3(0.0);
        float total = 0.0;
        for (int i = 0; i < ZOOM_TAPS; ++i)
        {
            float f = float(i) / float(ZOOM_TAPS - 1);
            float weight = 1.0 - 0.55 * f;
            blurred += omw_GetLastShader(mix(omw_TexCoord, centre, f * uRadial * s)).rgb * weight;
            total += weight;
        }
        blurred /= max(total, 0.0001);

        vec3 color = ccTone(blurred, s);

        // Round bloom over the quarter res bright buffer, already soft from
        // being downsampled with linear filtering.
        vec2 aspect = vec2(omw.resolution.x / omw.resolution.y, 1.0);
        vec3 glare = vec3(0.0);
        total = 0.0;
        for (int i = 0; i < GLARE_TAPS; ++i)
        {
            float fi = float(i);
            float angle = fi * 2.39996323;
            float radius = sqrt((fi + 0.5) / float(GLARE_TAPS)) * uBloomRadius;
            float weight = 1.0 - 0.55 * radius / max(uBloomRadius, 0.0001);
            vec2 offset = vec2(cos(angle), sin(angle)) * radius / aspect;
            glare += omw_Texture2D(RT_CCGlare, omw_TexCoord + offset).rgb * weight;
            total += weight;
        }
        // The light the bloom adds carries the flash's colour with it.
        glare /= max(total, 0.0001);
        // Repaint the bloom in the tint before adding it, so the flash brings
        // its own colour into the room instead of amplifying the room's.
        float glareLuma = dot(glare, CJ_LUMA);
        glare = mix(glare, vec3(glareLuma), uGlareColorize) * uGlareTint;
        color += glare * uBloom * s;

        float luma = dot(color, CJ_LUMA);
        color = mix(vec3(luma), color, mix(1.0, uSaturation, s));

        // Everything below is held off the shadows. Laid over the whole frame it
        // reads as a colour filter; kept to what is already lit it reads as the
        // light itself going cold, which is the point.
        float lit = smoothstep(uLitFrom, uLitFrom + 0.45, luma);
        color += uGlareTint * uWash * s * lit;
        color = mix(color, uTint * max(luma, 0.0), uTintAmount * s * lit);

        omw_FragColor = vec4(color, scene.a);
    }
}

technique {
    passes = cc_bright, cj_flash;
    description = "Combat Juice: a kill flash - zoom blur and contrast after Sanguine Symphony's death imagespace, with the cold bloom of the footage it was shown in.";
    version = "1.2";
    author = "Max Yari";
    dynamic = true;
}
